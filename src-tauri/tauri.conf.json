{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meteor",
  "version": "1.1.5",
  "identifier": "Meteor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meteor",
        "width": 1040,
        "height": 640,
        "minWidth": 940,
        "minHeight": 580,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}